---
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
import logo from "../assets/logo.png";
import calculatorShot from "../assets/running-calculator.png";
import Button from "../components/Button.astro";
import EventCard from "../components/EventCard.astro";
import { LINKS } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentEvents, getEvents } from "../lib/events";

const events = await getEvents();
const current = currentEvents(events);
// Feature the next upcoming/in-progress event, or the latest results if nothing is on.
const featured = current[0] ?? events[0];
const recent = events.filter((e) => e !== featured && !current.includes(e)).slice(0, 3);
---

<BaseLayout>
  <!-- Hero: the image carries the club name and stripes, so it is shown uncropped. -->
  <section class="bg-navy-950">
    <Image
      src={hero}
      alt="Bush Turkey Track Club members sprinting off the start line at Deagon, under the club logo and the title Bush Turkey Track Club, established 2021"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="mx-auto aspect-video w-full max-w-[1920px] object-cover"
    />
  </section>

  <!-- Intro -->
  <section class="container-page grid gap-10 py-14 md:grid-cols-[1fr_auto] md:items-center md:py-20">
    <div class="max-w-2xl">
      <p class="font-display text-2xl tracking-widest text-turkey">Gobble, gobble!</p>
      <h1 class="text-6xl leading-[0.9] sm:text-7xl">Bush Turkey Track Club</h1>
      <div class="mt-6 space-y-4 text-lg text-navy-800">
        <p>
          Welcome to the <strong class="text-navy-950">Bush Turkey Track Club</strong>, a performance-focused team of
          amateur distance runners established in 2021. Based around Brisbane's Bramble Bay and surrounding suburbs,
          we're a close-knit group of athletes with a shared love of running and improving performance.
        </p>
        <p>
          We train together on Tuesdays and Fridays as well as a Sunday group long run. We also love to have fun,
          featuring entertaining and competitive races throughout the year.
        </p>
        <p>We're always on the lookout for new members. Direct message us on Instagram to join us for a run.</p>
      </div>
      <div class="mt-6">
        <Button href={LINKS.instagram} variant="primary" icon="instagram">Message us on Instagram</Button>
      </div>
    </div>
    <Image src={logo} alt="" width={320} class="mx-auto hidden w-64 md:block lg:w-80" />
  </section>

  <!-- Events -->
  <section class="bg-navy-50 py-16">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{current.length ? "Next up" : "Latest results"}</p>
          <h2 class="text-5xl">{current.length ? "Upcoming events" : "Recent events"}</h2>
        </div>
        <Button href="/events/" icon="arrow">All events</Button>
      </div>
      {featured && (
        <div class="mt-8">
          <EventCard event={featured} featured />
        </div>
      )}
      {
        current.length > 1 && (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {current.slice(1).map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        )
      }
      {
        !current.length && (
          <p class="mt-6 text-navy-700">
            Our next event will be announced soon. Follow us on{" "}
            <a href={LINKS.instagram} class="font-semibold text-turkey underline">
              Instagram
            </a>{" "}
            for updates.
          </p>
        )
      }
      {
        recent.length > 0 && (
          <>
            <h3 class="mt-14 text-3xl">Previous events</h3>
            <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {recent.map((event) => (
                <EventCard event={event} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- Calculator -->
  <section class="container-page grid items-center gap-10 py-16 md:grid-cols-2">
    <div>
      <p class="eyebrow">Tools</p>
      <h2 class="text-5xl">Running calculator</h2>
      <p class="mt-3 text-lg text-navy-800">
        Enter a recent race result to calculate your training paces and predict race times.
      </p>
      <div class="mt-6">
        <Button href="/running-calculator/" variant="primary" icon="calculator">Open the calculator</Button>
      </div>
    </div>
    <a href="/running-calculator/" class="block overflow-hidden rounded-2xl shadow-lg ring-1 ring-navy-100">
      <Image src={calculatorShot} alt="Screenshot of the running calculator" width={800} />
    </a>
  </section>
</BaseLayout>
